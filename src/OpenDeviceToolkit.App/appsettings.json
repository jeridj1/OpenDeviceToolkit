{
  "workspace": {
    "rootPath": "D:\\OpenDeviceToolkit",
    "ensureDirectoriesOnStartup": true
  },
  "adb": {
    "customPath": null,
    "searchPaths": [
      "platform-tools",
      "adb",
      "fastboot",
      "Android\\sdk\\platform-tools",
      "Android\\sdk\\tools",
      "Android\\sdk\\tools\\bin"
    ],
    "timeoutSeconds": 10
  },
  "logging": {
    "logLevel": "Info",
    "maxFileSizeBytes": 10485760,
    "retainDays": 30
  }
}
