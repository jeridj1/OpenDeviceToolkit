<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>true</WarningsAsErrors>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- The repository contains two generations of the hardware API. The split RP2040
       implementation and newer probe/UART APIs are the coherent set; exclude the
       older monolithic/duplicate definitions from compilation. -->
  <ItemGroup>
    <Compile Remove="Rp2040BridgeProtocol.cs" />
    <Compile Remove="ProbeSafety.cs" />
    <Compile Remove="ProbeAuthorization.cs" />
    <Compile Remove="UartAnalyzer.cs" />
    <Compile Remove="Rp2040/Rp2040Controller.cs" />
  </ItemGroup>

</Project>
